{
  "name": "@project-vault/extension-api",
  "version": "3.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "description": "The typed extension contract and host-side registration helpers for Project Vault.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestormata/project-vault.git",
    "directory": "packages/extension-api"
  },
  "homepage": "https://github.com/nestormata/project-vault/tree/main/packages/extension-api",
  "bugs": {
    "url": "https://github.com/nestormata/project-vault/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@project-vault/eslint-config": "workspace:*",
    "@project-vault/tsconfig": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
