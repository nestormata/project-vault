{
  "name": "@project-vault/cli",
  "version": "0.0.1",
  "private": true,
  "description": "Terminal CLI for fetching and injecting Project Vault secrets. Binary name is `pvault` (not `pv` — see README's \"Package/binary name\" decision).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pvault": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "build": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@project-vault/agent": "workspace:*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@project-vault/api": "workspace:*",
    "@project-vault/eslint-config": "workspace:*",
    "@project-vault/tsconfig": "workspace:*",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "postgres": "^3.4.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
