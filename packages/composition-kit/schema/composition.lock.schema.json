{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nestormata/project-vault/packages/composition-kit/schema/composition.lock.schema.json",
  "title": "composition.lock.json (@project-vault/composition-kit lockfileVersion 2)",
  "description": "Written by pv-compose and committed. Hashes and paths only: no CM or PV file content. Deterministic: sorted keys and arrays, no timestamps, no absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lockfileVersion",
    "compatibility",
    "overrides",
    "additions",
    "removals",
    "replacements",
    "materialized",
    "contributions",
    "excludedPvTests",
    "injectionPointsUsed",
    "navIdsReferenced",
    "apiRouteOverrides",
    "notes"
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"] },
    "stringArray": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "lockfileVersion": { "const": 2 },
    "compatibility": {
      "type": "object",
      "required": [
        "schemaVersion",
        "pvRelease",
        "extensionApiVersion",
        "kitVersion",
        "toolchain",
        "apiImageTag"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "pvRelease": { "$ref": "#/definitions/version" },
        "extensionApiVersion": { "$ref": "#/definitions/version" },
        "kitVersion": { "$ref": "#/definitions/version" },
        "toolchain": {
          "type": "object",
          "required": ["kit", "svelte", "typescript", "vite"],
          "properties": {
            "kit": { "$ref": "#/definitions/version" },
            "svelte": { "$ref": "#/definitions/version" },
            "typescript": { "$ref": "#/definitions/version" },
            "vite": { "$ref": "#/definitions/version" }
          }
        },
        "apiImageTag": { "type": "string" }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "hostSha256", "cmSha256", "story", "hostVersion"],
        "properties": {
          "path": { "type": "string" },
          "hostSha256": { "$ref": "#/definitions/sha256" },
          "cmSha256": { "$ref": "#/definitions/sha256" },
          "story": { "$ref": "#/definitions/nullableString" },
          "hostVersion": { "$ref": "#/definitions/version" }
        }
      }
    },
    "additions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "cmSha256"],
        "properties": {
          "path": { "type": "string" },
          "cmSha256": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "removals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "matched", "hostSha256", "hostVersion", "files"],
        "properties": {
          "path": { "type": "string" },
          "matched": { "type": "integer", "minimum": 0 },
          "hostSha256": {
            "oneOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }]
          },
          "hostVersion": { "$ref": "#/definitions/version" },
          "files": { "$ref": "#/definitions/stringArray" }
        }
      }
    },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "with", "hostSha256", "cmSha256", "story", "hostVersion"],
        "properties": {
          "target": { "type": "string" },
          "with": { "type": "string" },
          "hostSha256": { "$ref": "#/definitions/sha256" },
          "cmSha256": { "$ref": "#/definitions/sha256" },
          "story": { "$ref": "#/definitions/nullableString" },
          "hostVersion": { "$ref": "#/definitions/version" }
        }
      }
    },
    "materialized": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source", "cmSha256"],
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string" },
          "cmSha256": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hooks", "nav", "theme", "protectedPaths"],
      "properties": {
        "hooks": { "type": "object", "additionalProperties": { "type": "string" } },
        "nav": { "$ref": "#/definitions/nullableString" },
        "theme": { "$ref": "#/definitions/nullableString" },
        "protectedPaths": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["add", "remove"],
              "properties": {
                "add": { "$ref": "#/definitions/stringArray" },
                "remove": { "$ref": "#/definitions/stringArray" },
                "derived": {
                  "description": "Story 68.6: CM routes under (app) the composer protects. Absent in locks written before 68.6 (read as []).",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["routeId", "urlPattern"],
                    "properties": {
                      "routeId": { "type": "string" },
                      "urlPattern": { "type": "string" }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "excludedPvTests": { "$ref": "#/definitions/stringArray" },
    "injectionPointsUsed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file"],
        "properties": {
          "name": { "type": "string" },
          "file": { "$ref": "#/definitions/nullableString" }
        }
      }
    },
    "guardEntries": {
      "description": "Story 68.9: sha256 (canonical JSON) of each section of the generated guard-entries module src/lib/composition/guard-entries.generated.json. PV's web guards recompute these and fail on a hand-edited file. Optional: a lock written before it existed is read as having none.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/sha256" }
    },
    "injections": {
      "description": "Story 68.4: every injection contribution (composed paths) in point and order order. Optional: a lock written before it existed is read as having none.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "component", "order", "load", "actions", "routeId", "scope"],
        "properties": {
          "point": { "type": "string" },
          "component": { "type": "string" },
          "order": { "type": "number" },
          "load": { "$ref": "#/definitions/nullableString" },
          "actions": { "$ref": "#/definitions/nullableString" },
          "routeId": { "$ref": "#/definitions/nullableString" },
          "scope": { "$ref": "#/definitions/nullableString" }
        }
      }
    },
    "navIdsReferenced": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "operative"],
        "properties": { "id": { "type": "string" }, "operative": { "type": "boolean" } }
      }
    },
    "navIdsDeclared": {
      "description": "Story 68.7: the nav ids the UI pack inserts (absent in older locks).",
      "$ref": "#/definitions/stringArray"
    },
    "navIdsHost": {
      "description": "Story 68.7 (informational): the web-host nav ids this lock was written against.",
      "$ref": "#/definitions/stringArray"
    },
    "apiRouteOverrides": {
      "description": "Story 68.14: the module pack's apiRoutes.override table (method, normalized url, mode, replaceSecurity), sorted by method and url. Empty without --module-pack. Recorded for review, never refused; --check compares it.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "url", "mode", "replaceSecurity"],
        "properties": {
          "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] },
          "url": { "type": "string", "pattern": "^/" },
          "mode": { "enum": ["replace", "wrap"] },
          "replaceSecurity": { "type": "boolean" }
        }
      }
    },
    "notes": { "$ref": "#/definitions/stringArray" }
  }
}
