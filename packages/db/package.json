{
  "name": "@project-vault/db",
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pg-tls": {
      "types": "./dist/pg-tls.d.ts",
      "default": "./dist/pg-tls.js"
    },
    "./test-helpers": {
      "types": "./dist/test-helpers.d.ts",
      "default": "./dist/test-helpers.js"
    },
    "./seed-fixtures": {
      "types": "./dist/seed-fixtures.d.ts",
      "default": "./dist/seed-fixtures.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./check-audit-actor-token-coverage": {
      "types": "./dist/check-audit-actor-token-coverage.d.ts",
      "default": "./dist/check-audit-actor-token-coverage.js"
    },
    "./function-executability": {
      "types": "./dist/function-executability.d.ts",
      "default": "./dist/function-executability.js"
    },
    "./migration-safety": {
      "types": "./dist/lib/migration-safety.d.ts",
      "default": "./dist/lib/migration-safety.js"
    },
    "./supported-locales": {
      "types": "./dist/supported-locales.d.ts",
      "default": "./dist/supported-locales.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "build": "tsc && mkdir -p dist/sql && cp src/sql/function-executability.sql dist/sql/function-executability.sql",
    "generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/guarded-migrate.ts",
    "db:seed:test": "tsx src/seed-test.ts",
    "db:seed:demo": "tsx src/seed-demo.ts",
    "extension:grants": "tsx src/scripts/extension-grants.ts"
  },
  "dependencies": {
    "@project-vault/crypto": "workspace:*",
    "@project-vault/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@project-vault/eslint-config": "workspace:*",
    "@project-vault/tsconfig": "workspace:*",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
