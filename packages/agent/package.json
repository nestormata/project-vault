{
  "name": "@project-vault/agent",
  "version": "0.0.1",
  "private": true,
  "description": "Machine-user authentication and secret retrieval for Project Vault. Consumed as a workspace dependency by @project-vault/vault-action (which bundles it) and @project-vault/cli; not published to any registry.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache-crypto": {
      "types": "./dist/cache-crypto.d.ts",
      "default": "./dist/cache-crypto.js"
    },
    "./build-info": {
      "types": "./dist/build-info.d.ts",
      "default": "./dist/build-info.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "build": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@project-vault/eslint-config": "workspace:*",
    "@project-vault/tsconfig": "workspace:*",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
