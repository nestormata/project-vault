{
  "name": "@project-vault/agent",
  "version": "0.0.1",
  "private": true,
  "description": "Machine-user authentication and secret retrieval for Project Vault. Bundled into @project-vault/vault-action; not published to any registry.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache-crypto": {
      "types": "./dist/cache-crypto.d.ts",
      "default": "./dist/cache-crypto.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "build": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@project-vault/eslint-config": "workspace:*",
    "@project-vault/tsconfig": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
