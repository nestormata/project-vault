# Full-monorepo image for `make ci` (see docker-compose.ci.yml + docs/development.md).
# Unlike apps/api/Dockerfile and apps/web/Dockerfile (which each build one deployable app), this
# image installs every workspace package's devDependencies so the whole `make ci` gate — typecheck,
# lint, tests, jscpd, generated-spec drift — can run in one container, on the Docker network, talking
# to the `db` service by its internal service name (`db:5432`) instead of a host-published port.
# That's what actually fixes cross-worktree DB contention: container/volume/network names are
# already isolated per-worktree (Compose namespaces them by the worktree's directory name), so
# running CI *inside* that same isolated network sidesteps host ports entirely for this path.
#
# `.git` is excluded here (see .dockerignore) and bind-mounted read-only at runtime instead
# (docker-compose.ci.yml) — the git-history-dependent checks (generated-spec/openapi drift and
# other repository checks) need real repo metadata, and bind-mounting it avoids having to rebuild this image on every
# commit just to keep `.git` current.
FROM node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

RUN npm install -g pnpm@11.28.3 --ignore-scripts
# g++/make/python3: argon2 (packages/crypto) native rebuild, same as apps/api/Dockerfile.
# git: generated-spec/openapi checks shell out to git against the bind-mounted .git.
# bash: the root Makefile sets `SHELL := /usr/bin/env bash`; Alpine's base image only ships `sh`.
# Story 43.16: openssl mints the runtime test PKI (no key/cert fixtures are committed); GNU
# findutils/coreutils give the Fly TLS script tests `find -printf` and `base64 -w0`.
# Story 43.28: jq for the Fly script tests (fly-ensure-started.sh parses `flyctl machine list --json`).
RUN apk add --no-cache g++ make python3 git postgresql16-client bash openssl findutils coreutils jq

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
# Story 66-7: patchedDependencies needs patches/ for the frozen install.
COPY patches ./patches
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/agent/package.json ./packages/agent/
COPY packages/api-contract-tests/package.json ./packages/api-contract-tests/
COPY packages/crypto/package.json ./packages/crypto/
COPY packages/db/package.json ./packages/db/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/extension-api/package.json ./packages/extension-api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/vault-action/package.json ./packages/vault-action/
COPY fixtures/mock-sso-extension/package.json ./fixtures/mock-sso-extension/

# pnpm >= 11.28 refuses `--frozen-lockfile` when any workspace member recorded in
# pnpm-lock.yaml lacks its package.json, even if this image never builds that member.
# Copy the remaining members' manifests (manifests only, no sources) so the install
# validates the whole lockfile. The sources stay out of this image.
COPY fixtures/mock-api-routes-extension/package.json ./fixtures/mock-api-routes-extension/
COPY fixtures/mock-audit-event-source-extension/package.json ./fixtures/mock-audit-event-source-extension/
COPY fixtures/mock-capability-gate-extension/package.json ./fixtures/mock-capability-gate-extension/
COPY fixtures/mock-envelope-extension/package.json ./fixtures/mock-envelope-extension/
COPY fixtures/mock-ui-panel-extension/package.json ./fixtures/mock-ui-panel-extension/
COPY fixtures/mock-ui-pack/package.json ./fixtures/mock-ui-pack/
COPY packages/cli/package.json ./packages/cli/
COPY packages/composition-kit/package.json ./packages/composition-kit/
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm rebuild argon2 esbuild

# .git is bind-mounted at runtime (docker-compose.ci.yml), owned by the host user — git's
# "dubious ownership" safety check (CVE-2022-24765 mitigation) otherwise refuses to operate on a
# repo owned by a different UID than the process running git, and fails in a confusing way (falls
# back to `--no-index` usage help instead of a clear ownership error, for every git-based check).
RUN git config --global --add safe.directory /app

COPY . .

CMD ["make", "ci-inner"]
