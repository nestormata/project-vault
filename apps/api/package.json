{
  "name": "@project-vault/api",
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./client-version-policy": {
      "types": "./dist/modules/client-versions/policy.d.ts",
      "default": "./dist/modules/client-versions/policy.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:timing": "RUN_TIMING_TESTS=1 vitest run src/modules/credential-shares/external-timing.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "generate-spec": "tsx src/scripts/generate-spec.ts",
    "route-audit:runtime": "tsx src/scripts/runtime-route-audit.ts",
    "sso:qa": "tsx src/scripts/sso-qa.ts",
    "operator:recovery-link": "tsx src/scripts/operator-recovery-link.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1154.0",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "10.2.5",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-zod": "^1.0.1",
    "@project-vault/crypto": "workspace:*",
    "@project-vault/db": "workspace:*",
    "@project-vault/extension-api": "workspace:*",
    "@project-vault/shared": "workspace:*",
    "bcrypt": "6.0.0",
    "drizzle-orm": "^0.45.4",
    "fast-jwt": "6.3.5",
    "fastify": "5.12.7",
    "fastify-plugin": "^6.0.1",
    "ipaddr.js": "2.5.0",
    "nodemailer": "^10.1.7",
    "otpauth": "9.5.2",
    "pg-boss": "12.38.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "undici": "8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@project-vault/agent": "workspace:*",
    "@project-vault/eslint-config": "workspace:*",
    "@project-vault/mock-api-routes-extension": "workspace:*",
    "@project-vault/mock-audit-event-source-extension": "workspace:*",
    "@project-vault/mock-capability-gate-extension": "workspace:*",
    "@project-vault/mock-delegation-audit-extension": "workspace:*",
    "@project-vault/mock-envelope-extension": "workspace:*",
    "@project-vault/mock-sso-extension": "workspace:*",
    "@project-vault/mock-ui-pack": "workspace:*",
    "@project-vault/mock-ui-panel-extension": "workspace:*",
    "@project-vault/tsconfig": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/form-data": "^2.5.2",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "form-data": "^4.0.6",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
