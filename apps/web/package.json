{
  "name": "@project-vault/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --emit-ts-declarations --silent",
    "lint": "pnpm run paraglide:compile && eslint .",
    "test": "vitest run --coverage",
    "test:coverage-buffer": "rm -rf coverage && vitest run --coverage && tsx scripts/check-coverage-buffer.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm run paraglide:compile && svelte-kit sync && tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@project-vault/eslint-config": "workspace:*",
    "@project-vault/mock-envelope-extension": "workspace:*",
    "@project-vault/tsconfig": "workspace:*",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.0.1",
    "otpauth": "^9.5.1",
    "postgres": "^3.4.9",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@project-vault/extension-api": "workspace:*",
    "@project-vault/shared": "workspace:*",
    "dompurify": "3.4.14"
  }
}
