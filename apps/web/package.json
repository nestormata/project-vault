{
  "name": "@project-vault/web-host",
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./svelte.config": "./config/svelte.config.ts",
    "./vite.config": "./config/vite.config.ts",
    "./vitest.config": "./config/vitest.config.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --emit-ts-declarations --silent",
    "lint": "pnpm run paraglide:compile && eslint .",
    "test": "vitest run --coverage",
    "test:coverage-buffer": "rm -rf coverage && vitest run --coverage && tsx scripts/check-coverage-buffer.ts",
    "test:e2e": "playwright test",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck": "pnpm run paraglide:compile && svelte-kit sync && tsc --noEmit && pnpm run check:svelte && pnpm run typecheck:e2e && pnpm run typecheck:config",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:config": "tsc -p config/tsconfig.json"
  },
  "devDependencies": {
    "@inlang/plugin-message-format": "4.4.4",
    "@playwright/test": "^1.63.0",
    "@project-vault/eslint-config": "workspace:*",
    "@project-vault/mock-envelope-extension": "workspace:*",
    "@project-vault/tsconfig": "workspace:*",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.1.1",
    "otpauth": "9.5.2",
    "postgres": "^3.4.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@project-vault/extension-api": "workspace:*",
    "@project-vault/shared": "workspace:*",
    "dompurify": "3.4.16",
    "undici": "8.11.2"
  }
}
