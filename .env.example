# =============================================================================
# Project Vault — example environment file
# =============================================================================
# Copy to `.env` and edit:  cp .env.example .env
#
# HOW THIS FILE IS ORGANISED
#   SECTION 1  Required in production — must be changed before any non-dev deploy
#   SECTION 2  Local defaults & tunables — safe as shipped; override only to tune
#   SECTION 3  Optional features — every one of these is off/absent by default
#   SECTION 4  Compose-only — read by docker-compose*.yml, not by the API's schema
#   SECTION 5  Operator-only — never place these in the API container environment
#
# WHO READS THIS FILE
#   * `docker compose` auto-loads `.env` and interpolates ${VAR} in docker-compose*.yml.
#   * The API itself does NOT load `.env` (no dotenv). For a host-run API (`pnpm turbo dev`,
#     `make test`) you must export the variables yourself — see docs/operator-quickstart.md.
#   * Every key the API's Zod schema knows about lives in this file; `pnpm check-env-example`
#     is a CI gate that fails if one is missing.
#
# PORTS ARE PER-CHECKOUT
#   `make bootstrap`, `make bootstrap-docker`, `make docker-up`, `make docker-smoke` and
#   `make e2e` all run `scripts/docker-ports.sh fix`, which rewrites DB_HOST_PORT /
#   API_HOST_PORT / WEB_HOST_PORT below to checkout-specific values (2xxxx/3xxxx/4xxxx) so
#   several worktrees can run at once — even when 5432/3000/5173 are free. Read the real
#   values back with `grep -E '^(DB|API|WEB)_HOST_PORT=' .env`. To keep the classic ports on
#   a single checkout, export DOCKER_PORTS_KEEP_DEFAULTS=1.
#
# Full reference for every key: docs/configuration.md
# =============================================================================


# =============================================================================
# SECTION 1 — REQUIRED IN PRODUCTION
# =============================================================================

# --- Database roles ----------------------------------------------------------
# IMPORTANT: must use the vault_app role, NOT postgres. Using postgres bypasses all RLS.
# The port must match DB_HOST_PORT in section 4 (which `make ...` targets may have bumped).
# Inside Docker Compose the host is `db`, not `localhost`, and docker-compose.yml sets the
# api/web services' DATABASE_URL itself — this value is only used by a host-run API/tests.
DATABASE_URL=postgresql://vault_app:dev-only-change-in-prod@localhost:5432/project_vault
#
# PRODUCTION HARDENING (required before any non-dev deployment):
# The 'dev-only-change-in-prod' password created by 0001_rls_and_triggers.sql is a
# local-development placeholder only. Before deploying, either:
#   - Run `ALTER ROLE vault_app PASSWORD '<secure-random-password>'` immediately after migration, OR
#   - Configure pg_hba.conf to use scram-sha-256 or peer auth for vault_app and remove the
#     password from the role entirely: `ALTER ROLE vault_app NOLOGIN; ALTER ROLE vault_app LOGIN`
# Do the same for vault_admin below — it is a second, separate credential.

# Used by getAdminDb() for reviewed cross-org/pre-auth reads and four production maintenance
# writes. It must name the migrated, non-superuser BYPASSRLS role — never postgres, and never
# the same role as DATABASE_URL (the app rejects that). Migration 0071 creates vault_admin
# WITHOUT a usable password: the credential is provisioned separately (docker-compose's
# `admin-provision` service, or `make bootstrap`) before it works. Without it the API dies at
# boot with `FATAL: ADMIN_DATABASE_URL is required` or, once set but unprovisioned,
# `password authentication failed for user "vault_admin"`.
ADMIN_DATABASE_URL=postgresql://vault_admin:password@localhost:5432/project_vault

# --- Public origin & proxy ---------------------------------------------------
# The exact scheme://host[:port] a browser uses to reach the web app. Compose feeds it to the
# api service's CORS_ALLOWED_ORIGINS, the web service's ORIGIN (adapter-node CSRF check) and
# WEB_BASE_URL. Leave unset for local use — it then tracks WEB_HOST_PORT automatically. Any
# LAN / reverse-proxy / real-domain deployment MUST set it, or logins fail with CORS errors
# and form actions return 403. Compose-only key; see also CORS_ALLOWED_ORIGINS below.
PUBLIC_WEB_ORIGIN=

# Allowlist of browser origins the API accepts credentialed requests from. Under Docker this is
# derived from PUBLIC_WEB_ORIGIN; set it directly for a host-run API, or to add a second origin
# (Story 30.5: CentralizeMe's real origin must be listed here for the cross-origin handoff
# prepare call to succeed — the browser blocks the preflight before any code runs).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the web app, used to build invitation/recovery links in outgoing email. Under
# Docker, leaving this at the literal below is only correct while WEB_HOST_PORT is still 5173 —
# clear it (or set PUBLIC_WEB_ORIGIN) and compose derives the right value automatically.
WEB_BASE_URL=http://localhost:5173

# The app itself defaults this to TRUE whenever NODE_ENV=production, which is the case for every
# docker compose run. Browsers accept Secure cookies on http://localhost, so true is correct for
# both production and the local Docker stack. Set false only when serving plain HTTP on a LAN
# IP/hostname — otherwise nobody can log in there.
COOKIE_SECURE=true
# Set TRUST_PROXY=true only behind a trusted reverse proxy such as Traefik/nginx/Caddy, and set
# TRUST_PROXY_HOPS to the number of proxies in front of the API, so rate limiting and audit
# logging see the real client IP rather than the proxy's.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# --- The 12 production secrets ------------------------------------------------
# Generate a DISTINCT 32+ byte value for each: openssl rand -hex 32
# The app rejects placeholder-looking values, the repo's dev values, and any duplicate between
# two of these keys, at startup. docker-compose.yml ships public dev fallbacks for local use
# only; docker-compose.prod.yml makes all 12 hard-required.
#   for v in SESSION_SECRET REFRESH_TOKEN_HMAC_SECRET TOTP_REPLAY_HMAC_SECRET \
#            MFA_PENDING_SESSION_HMAC_SECRET INVITATION_TOKEN_HMAC_SECRET \
#            RECOVERY_TOKEN_HMAC_SECRET API_KEY_HMAC_SECRET MACHINE_JWT_SECRET \
#            STATUS_PAGE_TOKEN_HMAC_SECRET ERASURE_EMAIL_HASH_SECRET SSO_STATE_HMAC_SECRET \
#            OPERATIONAL_STATUS_TOKEN_HMAC_SECRET; do
#     sed -i "s|^$v=.*|$v=$(openssl rand -hex 32)|" .env
#   done

# Signs human session JWTs.
SESSION_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Keys the refresh-token hash.
REFRESH_TOKEN_HMAC_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Keys the TOTP replay-protection cache. Has its own dedicated dev-only fallback; it does NOT
# fall back to REFRESH_TOKEN_HMAC_SECRET — the app REJECTS the two being equal.
TOTP_REPLAY_HMAC_SECRET=
# Signs the short-lived pending-MFA session between password and TOTP step.
MFA_PENDING_SESSION_HMAC_SECRET=
# Keys team-invitation acceptance tokens.
INVITATION_TOKEN_HMAC_SECRET=
# Keys account-recovery/reactivation tokens.
RECOVERY_TOKEN_HMAC_SECRET=
# Keys the machine-user API-key hash.
API_KEY_HMAC_SECRET=
# Signs the machine token-exchange JWT — a second, independent HS256 context, distinct from
# the human-session SESSION_SECRET.
MACHINE_JWT_SECRET=
# Signs public status-page opaque tokens.
STATUS_PAGE_TOKEN_HMAC_SECRET=
# Keys data_erasure_requests.original_email_hash — never reuse an auth-token HMAC secret here.
ERASURE_EMAIL_HASH_SECRET=
# Signs the SSO login-state cookie/param, preventing callback CSRF/state tampering.
SSO_STATE_HMAC_SECRET=
# Keys the GET /status bearer-token hash (operational_status_tokens). Required in production
# exactly like the 11 above; docker-compose.prod.yml enforces it.
OPERATIONAL_STATUS_TOKEN_HMAC_SECRET=

# --- Vault key material -------------------------------------------------------
# Directory for envelope/file key halves — mounted read-only in production (Docker secrets /
# Kubernetes secretKeyRef convention). Defaults to /run/secrets if unset. The production
# overlay mounts the `vault_keys` named volume here; see docs/runbook.md § First-time deployment.
VAULT_KEY_DIR=/run/secrets
# Envelope mode only (16 bytes as 32 hex chars). Generate: openssl rand -hex 16
# Leave empty in development and for passphrase/file mode. If your vault WAS initialized in
# envelope mode, unseal fails at runtime without it (compose cannot check this for you).
VAULT_ENVELOPE_KEY_HALF=
# First-init protection — generate: openssl rand -base64 32 (minimum 32 characters).
# REQUIRED unless VAULT_ALLOW_REMOTE_INIT=true: without it every POST /api/v1/vault/init
# returns 403 BOOTSTRAP_FORBIDDEN, including from the web UI.
VAULT_BOOTSTRAP_TOKEN=
# Dev-only escape hatch that skips the bootstrap token. NEVER set true in production.
VAULT_ALLOW_REMOTE_INIT=false


# =============================================================================
# SECTION 2 — LOCAL DEFAULTS & TUNABLES
# =============================================================================
# These ship with working values. Change them only to tune behaviour.

# --- Process ------------------------------------------------------------------
API_PORT=3000
# Ignored by docker compose: docker-compose.yml forces NODE_ENV=production for the api and web
# services (which is what turns on the strict secret validation and COOKIE_SECURE=true).
NODE_ENV=development

# --- Logging & metrics (Story 1.10) -------------------------------------------
# LOG_LEVEL defaults to silent when NODE_ENV=test. Keep debug/trace out of production.
LOG_LEVEL=info
SERVICE_NAME=api
METRICS_BIND_HOST=127.0.0.1
# Set METRICS_BIND_HOST=0.0.0.0 only when an external Prometheus scraper is intended.

# --- Sessions & tokens --------------------------------------------------------
JWT_ACCESS_TTL_SECONDS=300
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ACTIVITY_DEBOUNCE_SECONDS=60
# 0 = unlimited concurrent sessions per user.
MAX_SESSIONS_PER_USER=0
JWT_MAX_CLOCK_SKEW_SECONDS=30
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_GRACE_WINDOW_SECONDS=30
MACHINE_JWT_TTL_SECONDS=3600

# --- TOTP MFA (Stories 1.8 / 1.12) --------------------------------------------
MFA_TOTP_ISSUER=Project Vault
MFA_TOTP_PERIOD_SECONDS=30
MFA_TOTP_DIGITS=6
MFA_TOTP_WINDOW=1
MFA_RECOVERY_CODE_COUNT=10
MFA_RECOVERY_CODE_BCRYPT_COST=12
TOTP_USED_CODES_TTL_MINUTES=90
MFA_PENDING_SESSION_TTL_SECONDS=300
MFA_LOGIN_MAX_ATTEMPTS=5
# Grace period before a newly privileged role must have MFA enrolled.
MFA_PRIVILEGED_ROLE_GRACE_DAYS=7

# --- Password hashing & registration ------------------------------------------
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
# Dev/test dummy hash used to equalize unknown-email login timing.
AUTH_DUMMY_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$c/PLdA7Wvhkg8hPqLu5AlQ$7zS8GhNtQTJsiMmJLErN9kM19VoNBM3PHV3OhidvHtY
AUTH_REGISTRATION_ENABLED=true

# --- Failed-auth detection & lockout ------------------------------------------
# FAILED_AUTH_THRESHOLD_* drive an async operator alert only; they never block a login.
FAILED_AUTH_THRESHOLD_COUNT=10
FAILED_AUTH_THRESHOLD_WINDOW_SECONDS=300
FAILED_AUTH_RETENTION_HOURS=24
FAILED_AUTH_RECORD_ENABLED=true
# Per-account login lockout (Story 1.22) — these two synchronously block login.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# --- Rate limits ---------------------------------------------------------------
# Global /register + /login per-IP limit. Only docker-compose.e2e.yml raises these.
AUTH_RATE_LIMIT_MAX=60
AUTH_REGISTER_RATE_LIMIT_MAX=10
# Public SSO domain-lookup limiter (Story 14.4).
AUTH_SSO_DOMAIN_LOOKUP_RATE_LIMIT_MAX=20
# Rate-limit test bypass (Story 3.6) — must be 'true' AND NODE_ENV=test for rate-limit
# enforcement to be skipped; never set outside a test run.
RATE_LIMIT_TEST_BYPASS=false

# --- Monitoring (Story 6.2) ----------------------------------------------------
MAX_SERVICE_ENDPOINTS_PER_PROJECT=25
HEALTH_CHECK_MAX_CONCURRENCY=20
ANOMALOUS_ACCESS_THRESHOLD_COUNT=5
ANOMALOUS_ACCESS_WINDOW_SECONDS=3600
# Minimum free disk percentage before GET /status reports disk pressure.
STATUS_DISK_MIN_FREE_PERCENT=10

# --- Rotation (Stories 5.2 / 5.3 / 5.5 / 5.6) ----------------------------------
# Rotation checklist retry cap — read fresh on every retry call.
ROTATION_MAX_RETRIES=3
# Break-glass emergency-rotation overlap window (minutes) and the stale-rotation detection
# job's threshold (minutes).
BREAK_GLASS_OVERLAP_MINUTES=60
STALE_ROTATION_THRESHOLD_MINUTES=60
# Break-glass double-submit idempotency window in seconds.
BREAK_GLASS_IDEMPOTENCY_WINDOW_SECONDS=10
# Stale-STAGED rotation alert threshold in DAYS — wholly separate from
# STALE_ROTATION_THRESHOLD_MINUTES above.
STALE_STAGED_ROTATION_THRESHOLD_DAYS=14
# Age at which a master key is reported as overdue for rotation.
KEY_ROTATION_MAX_AGE_DAYS=365

# --- Notifications & inbox ------------------------------------------------------
# Daily digest email hour (UTC, 0–23) — Story 3.2
NOTIFICATION_DIGEST_HOUR=8
# Inbox entry retention in days before automatic purge — Story 3.3
INBOX_RETENTION_DAYS=90

# --- Audit storage & per-org quotas (Stories 9.2 / 9.4 / 22.1) -------------------
AUDIT_LOG_STORAGE_LIMIT_GB=50
PLATFORM_AUDIT_RETENTION_DAYS=365
PLATFORM_AUDIT_STORAGE_LIMIT_GB=5
# Per-org audit-storage quota. Enforcement is ON by default and the per-org default quota is
# 2048 MB (2 GiB) — these two match the app's own defaults, so an instance that never sets them
# behaves identically to one that copies this file. 0 = unlimited for the numeric MB vars.
AUDIT_ORG_QUOTA_ENFORCEMENT_ENABLED=true
AUDIT_ORG_DEFAULT_STORAGE_QUOTA_MB=2048
AUDIT_ORG_USAGE_RECONCILE_CRON="0 5 * * 0"
AUDIT_ORG_USAGE_RECONCILE_TIMEOUT_MS=300000
AUDIT_ORG_USAGE_STALE_AFTER_HOURS=240
AUDIT_ORG_PREAUTH_ALERT_THRESHOLD_MB=0
# Physical-to-logical size multiplier used when comparing usage against the quota.
AUDIT_ORG_QUOTA_PHYSICAL_OVERHEAD_ESTIMATE=3.0
# Per-org audit write-rate limiting — off by default.
AUDIT_ORG_WRITE_RATE_ENFORCEMENT_ENABLED=false
AUDIT_ORG_DEFAULT_WRITE_RATE_PER_MIN=0
AUDIT_ORG_WRITE_RATE_WINDOW_MS=60000
PLATFORM_RESOURCE_USAGE_ORG_LIST_CAP=500

# --- Credential retention -------------------------------------------------------
# Credential retention purge is irreversible (Story 2.2). Defaults to dry-run (log-only) in
# production; set false only after verifying dry-run output and backups.
CREDENTIAL_RETENTION_DRY_RUN=true

# --- Theming ---------------------------------------------------------------------
# Directory of admin-installed custom theme definition files, inside the persistent Docker
# Compose volume (never the application image, so themes survive image upgrades). An absent
# directory is zero behaviour change.
VAULT_THEMES_DIR=/data/themes


# =============================================================================
# SECTION 3 — OPTIONAL FEATURES (all off / absent by default)
# =============================================================================

# --- API docs ---------------------------------------------------------------------
# Story 9.3 D5: exposes GET /api/v1/openapi.json and GET /api/v1/docs (Swagger UI) — a fully
# browsable map of every authenticated route and its exact request/response schema. Docs are
# auto-enabled when NODE_ENV is development or test, so most local/CI usage never sets this.
# Only set true in production if you intend to expose the docs deliberately (e.g. behind your
# own reverse-proxy auth) — see docs/runbook.md § Upgrades for the operational trade-off.
ENABLE_API_DOCS=false

# --- Email / SMTP (Story 18.6) -----------------------------------------------------
# Docker Compose defaults to its local Mailpit service; browse
# http://localhost:${MAILPIT_UI_HOST_PORT} (default 8025) to inspect delivered mail.
# These values are for the API container. For a host-run API use SMTP_HOST=127.0.0.1 and
# SMTP_PORT=${MAILPIT_SMTP_HOST_PORT} (default 1025) instead. For demo/production use your SMTP
# provider and set every required transport value together.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@project-vault.local

# --- Slack notifications (Story 3.1; omit to disable) --------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-path

# --- Encrypted backup & restore (Story 9.1) -------------------------------------------
# Backup is opt-in — leave BACKUP_STORAGE_PATH, BACKUP_S3_BUCKET and BACKUP_DATABASE_URL all
# empty to disable it entirely (AC-15). Configure exactly one destination
# (BACKUP_STORAGE_PATH XOR BACKUP_S3_BUCKET) plus BACKUP_DATABASE_URL — a connection that
# bypasses RLS (D4). For v1, reuse the superuser credential; operators may optionally create a
# dedicated BYPASSRLS `vault_backup` role.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_COUNT=7
# Story 9.6: operator-tunable, independent of the PRD's 24h RPO design target and of the
# hardcoded 24h orphan-staged-file cleanup window below.
BACKUP_MAX_AGE_HOURS=25
# Must be writable by uid:gid 1000:1000 (the container's non-root `node` user);
# docker-entrypoint.sh repairs ownership automatically for a named volume,
# see docs/runbook.md § Backup permission remediation for bind mounts.
BACKUP_STORAGE_PATH=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_DATABASE_URL=
# Story 9.6 D3.1: local staging directory for the S3 destination only — the encrypted backup is
# written here atomically BEFORE upload, and retained (not deleted) if the upload ultimately fails
# after retries, so a subsequent manual retry doesn't require re-running the entire dump+encrypt
# pipeline. Ignored entirely for the BACKUP_STORAGE_PATH (filesystem) destination.
# Unset default: os.tmpdir() + '/vault-backup-staging' — this does NOT survive a container
# restart (ephemeral /tmp). If you want a failed upload's staged file to survive a restart (so the
# 24h orphan-cleanup window, hardcoded and not itself configurable, is meaningful across restarts,
# not just within one process lifetime), set this to a path on a mounted, persistent volume —
# mirror this file's BACKUP_STORAGE_PATH volume-mount precedent in docker-compose.yml.
# Operator convention: a staged file older than 24h is swept automatically. To protect a file
# you're still manually investigating from that sweep, rename it to break the exact `.staged`
# suffix match (e.g. `....vault.staged` -> `....vault.staged.hold`) — the sweep only ever touches
# files matching `*.staged` literally.
BACKUP_S3_STAGING_PATH=
# Story 9.6 D3.9/AC-16b: optional monitoring threshold (bytes) for total staging-directory usage
# across all `.staged` files — raises a backup.staging_disk_pressure admin_alerts row if exceeded
# (e.g. during a prolonged S3 outage). Unset disables this check entirely; it is a monitoring
# addition only and never blocks a backup attempt from proceeding.
BACKUP_S3_STAGING_MAX_BYTES=

# --- External KMS unseal (Story 1.14) ---------------------------------------------------
# AWS KMS-backed unseal, an alternative to passphrase/envelope/file. No credentials env var:
# kmsKeyId is supplied per-request at POST /vault/init and the API uses the AWS SDK's standard
# credential-provider chain (IAM role or AWS_ACCESS_KEY_ID/SECRET). Leave VAULT_KMS_ENDPOINT
# empty in production — it is a LocalStack/test-only KMSClient endpoint override.
VAULT_KMS_ENDPOINT=

# --- Extensions (Stories 14.2 / 23.2 / 24.3) ---------------------------------------------
# Optional exact package identity of a founder-trusted extension package, dynamically imported
# at boot. Self-hosted Docker deployments never need this; leave empty for the tested, supported
# default (zero extension code loaded).
VAULT_EXTENSIONS_PACKAGE=
# Incident-only rollback escape for a same-major extension above the current host. It relaxes
# only the ceiling, warns on every boot, and should be disabled after the extension is rolled back.
VAULT_EXTENSIONS_ALLOW_API_VERSION_ABOVE_HOST=false
# Story 23.2 AC-8: break-glass — re-enables every native-credential route regardless of the
# resolved policy. Leave unset/false; only set true for an operator-directed incident recovery.
VAULT_NATIVE_LOGIN_BREAK_GLASS=false
# Story 23.2 AC-4a: skips the proving latch and disables native login on the strength of the
# extension manifest declaration alone. Leave unset/false unless you have validated your IdP
# replacement out of band.
VAULT_NATIVE_LOGIN_REPLACEMENT_CONFIRMED=false
# Optional separate pool for the extension's operator-approved DB scope. Never use postgres,
# vault_app, vault_admin, DATABASE_URL, or ADMIN_DATABASE_URL here. Default max is deliberately 3.
# The migration's dev-only role password must be rotated before production.
EXTENSION_DATABASE_URL=postgresql://vault_extension:dev-only-change-in-prod@localhost:5432/project_vault
EXTENSION_DATABASE_POOL_MAX=3

# --- Service-to-service integration (Story 26.1 / CM-E14.14) -------------------------------
# Static shared-secret gate for POST /api/v1/service/organizations. A dedicated secret, never
# shared with VAULT_BOOTSTRAP_TOKEN or any other secret in this file. Unset means the route is
# unreachable (fail-closed default). Generate: openssl rand -base64 32
SERVICE_PROVISIONING_TOKEN=
# Companion shared secret for the service-side revocation callback. Same fail-closed rules and
# the same generation recipe; see docs/runbooks/ for the revocation procedure.
SERVICE_REVOCATION_TOKEN=

# --- CentralizeMe browser handoff (Stories 30.x) --------------------------------------------
# Off by default. VAULT_HANDOFF_ENABLED gates the whole feature; VAULT_HANDOFF_INSTANCE_ID is
# this instance's identifier in the handoff claim; VAULT_HANDOFF_VERIFY_KEYS holds the router's
# public verification key(s); VAULT_HANDOFF_ISSUER is the exact expected `iss` claim (a mismatch
# rejects with handoff_malformed_claim); VAULT_HANDOFF_CLOCK_SKEW_WARN_MS is the tolerance above
# which a clock-skew warning is raised.
VAULT_HANDOFF_ENABLED=false
VAULT_HANDOFF_INSTANCE_ID=
VAULT_HANDOFF_VERIFY_KEYS=
VAULT_HANDOFF_CLOCK_SKEW_WARN_MS=20000
VAULT_HANDOFF_ISSUER=https://app.centralizeme.com

# --- SonarCloud Web API access (local tooling only) ------------------------------------------
# make sonar-issues / ./scripts/sonar-issues.sh — see docs/sonarqube.md. CI runs the scanner
# using sonar-project.properties; these local vars are only for reading results from the CLI.
# SONAR_TOKEN is a secret (SonarCloud > My Account > Security > Generate Token); never commit a
# real value. SONAR_ORGANIZATION/SONAR_PROJECT_KEY are not secret but are kept out of committed
# files anyway for consistency.
SONAR_TOKEN=
SONAR_ORGANIZATION=
SONAR_PROJECT_KEY=
# Only override if self-hosting SonarQube instead of SonarCloud.
SONAR_HOST_URL=https://sonarcloud.io


# =============================================================================
# SECTION 4 — COMPOSE-ONLY
# =============================================================================
# Read by docker-compose*.yml interpolation. They are NOT part of the API's env schema, so
# `pnpm check-env-example` does not police them — but a self-hosted operator does need them.

# POSTGRES_USER/PASSWORD/DB bootstrap the Postgres superuser for the `db` container itself
# (not the app's connection role). The vault_app role is created by db:migrate.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=project_vault

# Password the `admin-provision` service assigns to the vault_admin role, and the one
# docker-compose.yml builds the api service's ADMIN_DATABASE_URL from. Change it together with
# ADMIN_DATABASE_URL above for anything beyond local development.
VAULT_ADMIN_PASSWORD=password

# Host-side port bindings for `docker compose up` (container-internal ports are fixed).
# See the "PORTS ARE PER-CHECKOUT" note at the top of this file: make targets rewrite these.
DB_HOST_PORT=5432
API_HOST_PORT=3000
WEB_HOST_PORT=5173
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# docker-compose.images.yml (prebuilt GHCR images) — override to pin a release or a fork's
# namespace. See docs/container-images.md.
VAULT_IMAGE_REPO=ghcr.io/nestormata/project-vault
VAULT_IMAGE_TAG=latest

# docker-compose.nfs.yml only: host path of the mounted NFS export used as the backup
# destination (bind-mounted at /var/backups/vault). Required whenever that overlay is used.
BACKUP_NFS_PATH=


# =============================================================================
# SECTION 5 — OPERATOR-ONLY: NEVER PLACE THESE IN THE API ENVIRONMENT
# =============================================================================
# This credential is used by operator tooling to GRANT the extension role its scope. It is a
# higher-privilege connection than anything the API is allowed to hold. Keep it out of
# docker-compose environments, container env files, and any process that serves requests.
EXTENSION_GRANT_DATABASE_URL=
